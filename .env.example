# Copy this file to `.env` and fill in your values. Never commit `.env`.

# GEMINI_API_KEY: Required for AI transcription/summaries. Get one at https://aistudio.google.com/apikey
# It is only used by the server (server.ts) and is never sent to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Defaults to gemini-3-flash-preview.
# GEMINI_MODEL="gemini-3-flash-preview"
